{
  "name": "mapcode-ts",
  "version": "1.0.2",
  "description": "Library to encode/decode mapcodes to/from latitude/longitude. TypeScript port of mapcode-java.",
  "keywords": [
    "mapcode",
    "geocode",
    "geocoding",
    "latitude",
    "longitude",
    "coordinates",
    "location",
    "encode",
    "decode"
  ],
  "homepage": "https://github.com/mapcode-foundation/mapcode-ts#readme",
  "bugs": {
    "url": "https://github.com/mapcode-foundation/mapcode-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapcode-foundation/mapcode-ts.git"
  },
  "author": "Rijn Buve <rijn@buve.nl>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "NOTICE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:data": "node --experimental-strip-types scripts/generate-data.mts",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
